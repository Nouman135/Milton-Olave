# Canonical site URL: metadata, sitemap.xml and robots.txt
NEXT_PUBLIC_SITE_URL=https://www.miltonolave.com

# GoHighLevel inbound-webhook URL that receives the Contact and Pre-Order Questionnaire forms.
# Server-side only (read by app/api/lead/route.ts). Until it is set, the forms show their error message.
GHL_WEBHOOK_URL=

# Meta Pixel. Defaults to the ID installed on the original site; leave empty to disable.
NEXT_PUBLIC_FB_PIXEL_ID=579339168295301
